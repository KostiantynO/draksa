{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "strict": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,

    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    "allowJs": false,
    "isolatedDeclarations": true,
    "declaration": true,
    "composite": true,
    // "stableTypeOrdering": true, // ts6

    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.next/cache/tsconfig.app.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],

    "rootDir": "./",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/draksa/*": ["./src/draksa/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",

    "next-env.d.ts",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
